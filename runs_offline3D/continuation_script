#!/bin/sh
#SBATCH --job-name=test
#SBATCH --time=05-12:00:00     # run no longer than 60 hours
#SBATCH --mem-per-cpu=2500
#SBATCH --ntasks=40
#SBATCH --output=./SLURM_OUTPUT
#SBATCH --error=./SLURM_ERROR

export exe=$(ls mitgcmuv_* 2>/dev/null | head -n 1)

if [ -z $exe ]; then
    echo "Erreur : pas d'exécutable 'mitgcmuv_*'" >&2
    exit 1
fi

mpirun -np 40 ./$exe

